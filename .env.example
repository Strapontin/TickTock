# Copy to .env (gitignored). Foundry loads it for every forge command.

# The testnet scripts' signer (script/testnet/). A testnet-only key: never one that holds real funds.
# Generate one with `cast wallet new`.
PRIVATE_KEY=
TESTNET_ADDRESS=

# Optional: verification on Uniscan (Etherscan). Sourcify and Blockscout need no key.
ETHERSCAN_API_KEY=

# Don't set these here: the fork tests run whenever they're set. Pass them on the command line instead:
#   UNICHAIN_RPC_URL=https://mainnet.unichain.org UNICHAIN_SEPOLIA_RPC_URL=https://sepolia.unichain.org \
#   forge test --mp "test/fork/*"
